# 本机 core.autocrlf=true，靠以下规则保证 Linux 侧消费的文件检出时仍是 LF。
# 容器内 shell 遇到 CRLF 会报 "\r: not found"，CI 的 yml 同理。

# Shell 脚本
*.sh                text eol=lf
*.bash              text eol=lf

# 容器与编排
Dockerfile          text eol=lf
*.dockerfile        text eol=lf
.dockerignore       text eol=lf
docker-compose*.yml text eol=lf

# 配置与 CI
*.yml               text eol=lf
*.yaml              text eol=lf
*.toml              text eol=lf
*.sql               text eol=lf
.env*               text eol=lf
.gitignore          text eol=lf
.gitattributes      text eol=lf
Makefile            text eol=lf
*.mk                text eol=lf

# 必须 CRLF 的 Windows 脚本
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制资产：禁止任何 EOL/编码转换，避免损坏
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.svgz  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.jar   binary
*.zip   binary
*.gz    binary
*.pdf   binary
*.xlsx  binary
*.docx  binary
