# ======================================================================
# AI Service Agent 环境变量示例
# 复制为 .env 后按需修改： cp .env.example .env
# 不配置任何变量也能运行：默认使用内置 Mock 模型（离线、无需密钥）。
# ======================================================================

# ---------------- 大模型供应方 ----------------
# provider: mock（离线内置，默认）| openai（任意 OpenAI 兼容网关）
LLM_PROVIDER=mock

# --- 方案 A：OpenAI ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-your-openai-key

# --- 方案 B：DeepSeek ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-your-deepseek-key

# --- 方案 C：阿里通义千问（OpenAI 兼容模式）---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-your-dashscope-key

# --- 方案 D：本地 Ollama（OpenAI 兼容端点）---
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama

# 采样温度（0~1，越低越稳定）
LLM_TEMPERATURE=0.3

# ---------------- 本机端口（Docker Compose，可选）----------------
# 本项目固定使用 19040-19049：后端 19040、前端 19041、MySQL 19042。
FRONTEND_HOST_PORT=19041
BACKEND_HOST_PORT=19040
MYSQL_HOST_PORT=19042

# 业务日期、SLA、看板和工单编号统一时区。
APP_TIME_ZONE=Asia/Shanghai

# Compose forwards these values explicitly. For production use the required
# docker-compose.production.yml override and .env.production.example template.
APP_DEMO_ENABLED=true
APP_SECURITY_RBAC_ENABLED=true
APP_SECURITY_ANONYMOUS_CHAT=false
APP_SECURITY_COOKIE_SECURE=false
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:19041,http://localhost:19041
BUSINESS_ADAPTER=mock
BUSINESS_BASE_URL=
BUSINESS_API_TOKEN=
BUSINESS_TIMEOUT_SECONDS=5
BUSINESS_MAX_RETRIES=1
LLM_ALLOW_PRIVATE_BASE_URL=false

# Docker 内无法直连 Maven Central 时可临时指定可信镜像；留空即使用 Central。
# MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public

# ---------------- 数据库（docker-compose 已自动注入，本地开发可忽略）----------------
# 本地直接 mvn 运行时默认使用内存 H2，无需配置。
# DATABASE_URL=jdbc:mysql://localhost:19042/ai_service_agent?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
# DATABASE_USERNAME=csagent
# DATABASE_PASSWORD=csagentpwd
