# ======================================================================
# AI Service Agent 环境变量示例
# 复制为 .env 后按需修改： cp .env.example .env
# 不配置任何变量也能运行：默认使用内置 Mock 模型（离线、无需密钥）。
# ======================================================================

# ---------------- 大模型供应方 ----------------
# provider: mock（离线内置，默认）| openai（任意 OpenAI 兼容网关）
LLM_PROVIDER=mock

# --- 方案 A：OpenAI ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-your-openai-key

# --- 方案 B：DeepSeek ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-your-deepseek-key

# --- 方案 C：阿里通义千问（OpenAI 兼容模式）---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-your-dashscope-key

# --- 方案 D：本地 Ollama（OpenAI 兼容端点）---
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama

# 采样温度（0~1，越低越稳定）
LLM_TEMPERATURE=0.3

# ---------------- 数据库（docker-compose 已自动注入，本地开发可忽略）----------------
# 本地直接 mvn 运行时默认使用内存 H2，无需配置。
# DATABASE_URL=jdbc:mysql://localhost:3306/ai_service_agent?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
# DATABASE_USERNAME=csagent
# DATABASE_PASSWORD=csagentpwd
