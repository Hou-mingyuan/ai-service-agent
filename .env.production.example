# Required secrets are deliberately empty. Compose must reject this until filled.
DATABASE_USERNAME=csagent
DATABASE_PASSWORD=
MYSQL_ROOT_PASSWORD=
APP_SECURITY_JWT_SECRET=
APP_CORS_ALLOWED_ORIGINS=https://support.example.com
APP_TENANT_ID=production
APP_TIME_ZONE=Asia/Shanghai
APP_SECURITY_JWT_EXPIRATION_MINUTES=480
APP_SECURITY_COOKIE_NAME=CSAGENT_AUTH
APP_SECURITY_COOKIE_SAME_SITE=Strict
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_MAX_TOOL_ROUNDS=3
LLM_ALLOW_PRIVATE_BASE_URL=false
BUSINESS_BASE_URL=
BUSINESS_API_TOKEN=
BUSINESS_TIMEOUT_SECONDS=5
BUSINESS_MAX_RETRIES=1
# Host TLS proxy connects to this loopback listener.
FRONTEND_BIND_ADDRESS=127.0.0.1
